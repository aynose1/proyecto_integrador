# Host/LAN address reachable from the phone running Expo Go.
HOST_LAN_IP=192.168.1.8

# ============================================================
# .env raíz -- leído automáticamente por "docker compose" para
# sustituir las ${VARIABLES} en compose.private.yaml / compose.public.yaml.
# NUNCA subas este archivo a git (ya está en .gitignore).
# ============================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=12345678
MYSQL_DATABASE=gestion_residuos
MYSQL_USER=admin
MYSQL_APP_PASSWORD=12345678

# Usuario de solo-monitoreo para mysqld_exporter (Prometheus).
# Debe coincidir con lo que pongas en mysql/exporter.my.cnf.
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=12345678

# --- Grafana (compose.public.yaml) ---
GF_ADMIN_PASSWORD=12345678


PRIVATE_HOST_IP=host.docker.internal
PUBLIC_HOST_IP=localhost