global
    log stdout format raw local0
    maxconn 4096

    ssl-default-bind-options ssl-min-ver TLSv1.2

defaults
    log global
    mode http
    option httplog
    option forwardfor

    timeout connect 5s
    timeout client 30s
    timeout server 30s

frontend http_front
    bind *:80

    http-request redirect scheme https code 301

frontend https_front
    bind *:443 ssl crt /usr/local/etc/haproxy/certs/server.pem

    acl path_api path_beg /api
    acl path_grafana path_beg /grafana

    use_backend api_back if path_api
    use_backend grafana_back if path_grafana

    default_backend flask_back

# Frontend interno (HTTP plano, sin TLS): para que servicios de confianza
# en la misma red (Flask, el servidor de desarrollo de la app movil)
# hablen con la API ya balanceada, sin lidiar con el certificado
# autofirmado del frontend publico.
frontend api_internal_front
    bind *:8080
    mode http

    default_backend api_back

backend api_back
    balance roundrobin

    http-request replace-path ^/api/?(.*) /\1

    option httpchk GET /health
    http-check expect status 200

    # Solo 2 replicas de la API existen hoy (api1, api2) -- ver
    # compose.private.yaml. Si agregas una tercera replica ahi, agregala
    # aqui tambien.
    # PRIVATE_HOST_IP se sustituye al arrancar el contenedor (ver
    # Dockerfile/docker-entrypoint.sh de este mismo directorio) -- define
    # su valor en el .env de ESTE host (el que corre compose.public.yaml).
    server api1 ${PRIVATE_HOST_IP}:8001 check
    server api2 ${PRIVATE_HOST_IP}:8002 check

backend flask_back
    balance roundrobin

    option httpchk GET /
    http-check expect rstatus (2|3)[0-9][0-9]

    server flask1 ${PRIVATE_HOST_IP}:5001 check
    server flask2 ${PRIVATE_HOST_IP}:5002 check

backend grafana_back
    server grafana grafana:3000 check

listen stats
    bind *:8404
    mode http

    stats enable
    stats uri /stats
    stats refresh 5s
    stats show-legends
    stats show-node

frontend prometheus_front
    bind *:8405
    mode http

    http-request use-service prometheus-exporter if { path /metrics }
    http-request return status 404
