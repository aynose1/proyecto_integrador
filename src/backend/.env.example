# Base de datos MySQL / MariaDB
DB_USER=root
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gestion_residuos

# JWT
JWT_SECRET_KEY=cambia-esto-por-una-llave-larga-y-aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# API Key para el sistema embebido (sensores)
DEVICE_API_KEY=cambia-esto-tambien

# API Key de plataforma: capa extra junto al JWT, obligatoria en TODOS
# los endpoints salvo los de sensores. La MISMA llave va también en
# src/web/.env (PLATFORM_API_KEY) y en src/pi_movil/.env
# (EXPO_PUBLIC_PLATFORM_API_KEY) -- si no coinciden EXACTO en los 3
# lados, la web/app dejan de poder hablar con la API (401 en todo).
PLATFORM_API_KEY=cambia-esto-tambien-y-que-coincida-en-los-3-lados

# Rate limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_DEFAULT=100/minute
