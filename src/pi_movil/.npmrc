# Expo Router arrastra paquetes de soporte web (@radix-ui, vaul) cuyos
# peerDependencies de react/react-dom no calzan exacto con la versión
# de React que fija Expo SDK 54. Esto NO es un conflicto real para
# React Native (esos paquetes solo aplican al build web), así que se
# usa resolución "legacy" para no bloquear cada instalación con
# npm error ERESOLVE.
legacy-peer-deps=true
