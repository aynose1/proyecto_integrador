# URL base de la API FastAPI (sin barra final)
API_BASE_URL=http://localhost:8000

# Flask
FLASK_SECRET_KEY=cambia-esto-por-una-clave-secreta-larga
FLASK_DEBUG=true
FLASK_PORT=5000

# Nombre de la institución, se muestra en el encabezado del reporte PDF/Excel
INSTITUTION_NAME=Universidad Politécnica de Querétaro

# Debe coincidir EXACTO con PLATFORM_API_KEY en src/backend/.env, y con
# EXPO_PUBLIC_PLATFORM_API_KEY en src/pi_movil/.env -- misma llave
# compartida en los 3 lados.
PLATFORM_API_KEY=cambia-esto-tambien-y-que-coincida-en-los-3-lados
